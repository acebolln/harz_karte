{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/cbb-referenzen/hooks/gh-account.mjs\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node \"$HOME/cbb-referenzen/hooks/main-guard.mjs\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node \"$HOME/cbb-referenzen/hooks/pr-tests.mjs\"",
            "timeout": 300,
            "statusMessage": "Running tests before the PR"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/cbb-referenzen/hooks/secret-scan.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/cbb-referenzen/hooks/old-journal.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/cbb-referenzen/hooks/crlf-warn.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/cbb-referenzen/hooks/behind-origin.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
